xtUtils;\n+import com.fasterxml.jackson.databind.JsonNode;\n+import com.fasterxml.jackson.databind.node.ObjectNode;\n+import java.util.List;\n+import java.util.function.UnaryOperator;\n+\n+/** 在响应副本上刷新步骤内富文本资源，不修改持久化文档。 */\n+public final class TestStepsPreviewSupport {\n+    private TestStepsPreviewSupport() {\n+    }\n+\n+    public static Object refresh(Object value, UnaryOperator<String> refreshRichText) {\n+        if (value == null) {\n+            return null;\n+        }\n+        JsonNode document;\n+        try {\n+            document = value instanceof String text\n+                    ? JsonUtil.readTree(text)\n+                    : JsonUtil.getInstance().valueToTree(value);\n+        } catch (Exception exception) {\n+            return value;\n+        }\n+        if (document == null || !document.path(\"steps\").isArray()) {\n+            return value;\n+        }\n+        boolean changed = false;\n+        for (JsonNode step : document.path(\"steps\")) {\n+            for (String field : List.of(\"action\", \"expectedResult\", \"actualResult\", \"notes\")) {\n+                JsonNode content = step.get(field);\n+                if (content == null || content.isNull()) {\n+                    continue;\n+                }\n+                String original = content.isTextual() ? content.textValue() : content.toString();\n+                JsonNode richDocument;\n+                try {\n+                    richDocument = JsonUtil.readTree(original);\n+                } catch (Exception exception) {\n+                    continue;\n+                }\n+                if (richDocument == null || !\"doc\".equals(richDocument.path(\"type\").asText())) {\n+                    continue;\n+                }\n+                String refreshed = refreshRichText.apply(original);\n+                if (!original.equals(refreshed)) {\n+                    ((ObjectNode) step).set(field,\n+                            content.isTextual()\n+                         