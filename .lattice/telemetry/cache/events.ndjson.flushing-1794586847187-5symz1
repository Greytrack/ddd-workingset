0;\n+    c_version_type constant bigint := 10001;\n+    c_default_workingset constant bigint := 1;\n+    c_shared constant integer := 1;\n+    c_name constant varchar := '测试运行用例';\n+    c_description constant varchar := '新建产品空间，生成产品空间下默认Tracker';\n+    c_fallback_operator constant varchar := '419436436619264';\n+\n+    v_tracker_id bigint;\n+    v_relation_id bigint;\n+    v_serial integer;\n+    v_owner bigint;\n+    v_now bigint := (extract(epoch from clock_timestamp()) * 1000)::bigint;\n+    v_number varchar;\n+    rec record;\n+BEGIN\n+    SELECT GREATEST(\n+               COALESCE((SELECT MAX(id) FROM air_ws_tracker), 0),\n+               COALESCE((SELECT MAX(id) FROM air_inst_tracker_rev), 0),\n+               COALESCE((SELECT MAX(id) FROM air_inst_common), 0)\n+           ) + 1\n+      INTO v_tracker_id;\n+    SELECT COALESCE((SELECT MAX(id) FROM air_ws_workingset_branch_relation), 0) + 1\n+      INTO v_relation_id;\n+    SELECT GREATEST(\n+               COALESCE((SELECT MAX(SUBSTRING(number FROM 2)::integer) FROM air_ws_tracker\n+                          WHERE number ~ '^T[0-9]+$'), 0),\n+               COALESCE((SELECT MAX(SUBSTRING(number FROM 2)::integer) FROM air_inst_tracker_rev\n+                          WHERE number ~ '^T[0-9]+$'), 0)\n+           ) + 1\n+      INTO v_serial;\n+\n+    FOR rec IN\n+        SELECT d.work_space, d.workingset_id,\n+               ROW_NUMBER() OVER (ORDER BY d.work_space, d.workingset_id) AS rn\n+          FROM (\n+              SELECT DISTINCT r.work_space, r.workingset_id\n+                FROM air_ws_workingset_branch_relation r\n+                JOIN air_inst_product_space p ON p.id = r.work_space\n+               WHERE r.work_space IS NOT NULL\n+                 AND r.workingset_id = c_default_workingset\n+                 AND COALESCE(p.delete_flag, 0) = 0\n+                 AND NOT EXISTS (\n+                     SELECT 1\n+                       FROM air_ws_tracker t\n+                       JOIN air_ws_workingset_branch_relation tr ON tr.tracker_id = t.id\n+                      WHERE t.sub_class_id = c_sub_class_id\n+                        AND tr.work_space = r.work_space\n+                        AND tr.workingset_id = r.workingset_id\n+                        AND COALESCE(t.delete_flag, 0) = 0\n+                 )\n+          ) d\n+         ORDER BY d.work_space, d.workingset_id\n+    LOOP\n+        SELECT owner INTO v_owner FROM air_inst_product_space WHERE id = rec.work_space;\n+        IF v_owner IS NULL THEN\n+            v_owner := c_fallback_operator::bigint;\n+        END IF;\n+        v_number := 'T' || lpad((v_serial + rec.rn - 1)::text,\n+            GREATEST(4, length((v_serial + rec.rn - 1)::text)), '0');\n+\n+        INSERT INTO air_inst_common (id, base_class, class, type, tracker, work_space, workingset_id,\n+            name, number, revision, version, delete_flag, checked_out, owner, common_id, parent_id,\n+            lock_version, created_by, created_time, updated_by, updated_time)\n+        VALUES (v_tracker_id, c_tracker_base_class, c_tracker_class, c_tracker_type, c_tracker_bootstrap,\n+            rec.work_space, rec.workingset_id, c_name, v_number, 1, 'Draft.1', 0, 1, v_owner,\n+            v_tracker_id, 0, 0, v_owner::text, v_now, v_owner::text, v_now);\n+\n+        INSERT INTO air_ws_tracker (id, parent_id, number, name, description, workingset_id, sub_class_id,\n+            source_branch_id, visible, locked, shared, is_default, delete_flag, lock_version,\n+            created_by, created_time)\n+        VALUES (v_tracker_id, NULL, v_number, c_name, c_description, rec.workingset_id, c_sub_class_id,\n+            NULL, 1, 0, c_shared, 1, 0, 0, v_owner::text, v_now);\n+\n+        INSERT INTO air_inst_tracker_rev (id, base_class, class, type, tracker_class, tracker, instance_id,\n+            common_id, workingset_id, work_space, name, number, description, revision, version_type,\n+            owner, share, delete_flag, lock_version, created_by, created_time, updated_by, updated_time,\n+            default_layout)\n+        VALUES (v_tracker_id, c_tracker_base_class, c_tracker_class, c_tracker_type, c_sub_class_id,\n+            c_tracker_bootstrap, v_tracker_id, v_tracker_id, rec.workingset_id, rec.work_space, c_name,\n+            v_number, '', 1, c_version_type, v_owner, c_shared, 0, 0, v_owner::text, v_now,\n+            v_owner::text, v_now, c_default_layout);\n+\n+        INSERT INTO air_ws_workingset_branch_relation (id, workingset_id, work_space, tracker_id,\n+            lock_version, created_by, created_time, is_show)\n+        VALUES (v_relation_id, rec.workingset_id, rec.work_space, v_tracker_id, 0, v_owner::text, v_now, 1);\n+\n+        v_tracker_id := v_tracker_id + 1;\n+        v_relation_id := v_relation_id + 1;\n+    END LOOP;\n+END;\n+$$;\n+\n+CALL backfill_test_run_case_tracker();\n+DROP PROCEDURE IF EXISTS backfill_test_run_case_tracker();","ai_response_text":"<commit_message>\nfeat(workingset) 默认分支追加自动带入测试运行用例 tracker 并补齐历史数据 V3.8\n\n- DefaultBranchAppendStep 勾选测试管理相关基类时自动追加 testruncase 分类，缺少默认 tracker 时记录告警\n- 新增 V3.8.0.5 升级脚本，为历史产品空间默认工作集回填「测试运行用例」tracker 及绑定关系\n</commit_message>","generate_time":1794586829508,"user":"chenjiancheng","repo_remote_url":"http://192.168.11.245:3000/AirEdgeSoft/airedge.git","branch_name":"dev-3.8-cjc","agent_tool":"pi","source_session_id":"819a56e7ef773fced00c28b4be50b4b951d462506a3df7ead401eb1535910a11","ai_provider":"deepseek","ai_model":"deepseek-flash","requirement_id":null,"feature_name":null,"trace_id":null,"trace_source":null,"report_time":null}
