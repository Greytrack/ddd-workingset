    <packaging>pom</packaging>
    <name>lib-deps</name>
    <description>
        Third-party dependency version catalog (versions only here).
        Import in backend/pom.xml and airedge-v4/pom.xml dependencyManagement;
        modules declare third-party deps without versions.
    </description>

