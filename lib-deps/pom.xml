    <!-- 独立 BOM 自举：与 backend 根 pom 一致的 Nexus 仓库（无 parent 继承，需自带） -->
    <repositories>
        <repository>
            <id>AirRndPublic</id>
            <name>AirRndPublic Repository</name>
            <url>https://nexus.public.airedgesoft.com/repository/induslab-public-maven/</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>AirRndPluginPublic</id>
            <name>AirRndPluginPublic PluginRepository</name>
            <url>https://nexus.public.airedgesoft.com/repository/induslab-public-maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>always</updatePolicy>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
    <properties>
        <junit-jupiter.version>5.10.0</junit-jupiter.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <mybatis.plus.version>3.5.8</mybatis.plus.version>
        <jackson.version>2.17.1</jackson.version>
        <httpclient.version>4.5.13</httpclient.version>
        <hutool.version>5.8.28</hutool.version>
        <docx4j.version>11.4.11</docx4j.version>
        <!-- 本模块是独立 BOM（无 parent、无 Java 源码）：显式声明格式化插件版本并在本模块跳过，
             否则在 airedge-v4 聚合工程上执行 mvn spotless:check 会报
             "Spotless plugin absent from the project"（插件未继承自 backend 根 pom） -->
        <spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
        <spotless.skip>true</spotless.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <skip>${spotless.skip}</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>