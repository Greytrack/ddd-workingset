         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- 独立 BOM：不设 parent，供 backend（旧空间）与 airedge-v4（新空间）共同 import。
         之所以独立：backend 根 pom 要 import 本模块，若本模块 parent 仍是 backend 根 pom 会形成 BOM 解析循环。 -->
